# TestFlight uploads for Polly. Run them through scripts/testflight-macos.sh and scripts/testflight-ios.sh,
# which compute the "What to Test" notes and translate their flags into the lane options below.
# See "TestFlight" in DEVELOPERS.md.
opt_out_usage

ROOT = File.expand_path("..", __dir__)
TEAM_ID = "MF6WPNPK5H"
BUNDLE_ID = "nl.webhare.polly"

# The App Store Connect API key, or nil to fall back on the Apple ID signed in to Xcode (only enough for
# dry runs: uploading needs the key).
def asc_api_key
  return nil unless ENV["ASC_KEY_ID"]
  @asc_api_key ||= app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

def flag(options, name)
  options[name].to_s == "true"
end

# nil keeps CURRENT_PROJECT_VERSION from project.yml; "auto" takes the next number after the latest
# TestFlight build of this platform.
def build_number(options, platform)
  value = options[:build_number].to_s
  return nil if value.empty?
  return Integer(value) unless value == "auto"
  UI.user_error!("--build-number auto needs the App Store Connect API key") unless asc_api_key
  latest_testflight_build_number(api_key: asc_api_key, app_identifier: BUNDLE_ID, platform: platform,
                                 initial_build_number: 0) + 1
end

# Manual signing with a fixed certificate and profile when POLLY_PROFILE_NAME names an installed App Store
# profile (CI). Otherwise automatic signing, which on a clean CI machine would create a new development
# certificate on every run.
def signing(platform)
  profile = ENV["POLLY_PROFILE_NAME"].to_s
  if profile.empty?
    # With an API key Xcode creates the distribution certificate and profiles itself.
    xcargs = ["-allowProvisioningUpdates"]
    if asc_api_key
      xcargs += ["-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"), "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
                 "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")]
    end
    return [xcargs, { signingStyle: "automatic", teamID: TEAM_ID }]
  end

  xcargs = ["CODE_SIGN_STYLE=Manual", "DEVELOPMENT_TEAM=#{TEAM_ID}", "CODE_SIGN_IDENTITY=Apple Distribution",
            "PROVISIONING_PROFILE_SPECIFIER=#{profile}"]
  export = { signingStyle: "manual", teamID: TEAM_ID, signingCertificate: "Apple Distribution",
             provisioningProfiles: { BUNDLE_ID => profile } }
  # The macOS .pkg is signed with the Mac Installer Distribution certificate, which keeps its old name.
  export[:installerSigningCertificate] = "3rd Party Mac Developer Installer" if platform == "osx"
  [xcargs, export]
end

def beta(options, platform:, sdk:, destination:)
  xcargs, export_options = signing(platform)
  number = build_number(options, platform)
  xcargs << "CURRENT_PROJECT_VERSION=#{number}" if number
  # Hides the "Local build" line that local builds show.
  xcargs << "POLLY_BUILD_CHANNEL=appstore"

  file = build_app(
    project: File.join(ROOT, "Polly.xcodeproj"),
    scheme: "Polly",
    configuration: "Release",
    # Polly is one multiplatform target; gym only picks the platform from the SDK.
    sdk: sdk,
    destination: destination,
    export_method: "app-store",
    export_team_id: TEAM_ID,
    export_options: export_options,
    output_directory: File.join(ROOT, "build/testflight"),
    output_name: "Polly-#{platform}",
    xcargs: xcargs.map { |arg| arg.shellescape }.join(" "),
    clean: true
  )
  if flag(options, :dry_run)
    UI.important("Dry run: built #{file}, nothing uploaded")
    return
  end
  UI.user_error!("Uploading needs ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH") unless asc_api_key

  groups = options[:groups].to_s.split(",").map(&:strip).reject(&:empty?)
  upload_to_testflight(
    api_key: asc_api_key,
    app_platform: platform,
    (platform == "osx" ? :pkg : :ipa) => file,
    changelog: File.read(options.fetch(:notes_file)),
    groups: groups.empty? ? nil : groups,
    distribute_external: flag(options, :external),
    notify_external_testers: flag(options, :external),
    submit_beta_review: flag(options, :external),
    skip_waiting_for_build_processing: flag(options, :no_wait),
    uses_non_exempt_encryption: false
  )
end

platform :mac do
  desc "Build Polly for macOS and upload it to TestFlight"
  lane :beta do |options|
    beta(options, platform: "osx", sdk: "macosx", destination: "generic/platform=macOS")
  end
end

platform :ios do
  desc "Build Polly for iPhone and iPad and upload it to TestFlight"
  lane :beta do |options|
    beta(options, platform: "ios", sdk: "iphoneos", destination: "generic/platform=iOS")
  end
end
